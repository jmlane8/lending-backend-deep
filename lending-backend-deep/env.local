# Settings for running on localhost, read by the Makefile and Docker Compose.
# The credentials only protect the local Docker database. Never use them elsewhere.
# Values are read literally: don't add quotes, spaces, or a $ or # character.

APP_NAME=lending-backend-deep
APP_ENV=local

LOGGER_LEVEL=debug
LOGGER_OUTPUT=console

OPENAPI_UI_ENABLE=true
OPENAPI_UI_PATH=/redoc

HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=8080
HTTP_SERVER_READ_TIMEOUT=30
HTTP_SERVER_WRITE_TIMEOUT=30
HTTP_SERVER_SHUTDOWN_TIMEOUT=5

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=lending
POSTGRES_SCHEMA=public
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable
POSTGRES_CONN_MAX_OPEN=25
POSTGRES_CONN_MIN_IDLE=1

BUSINESS_TIMEZONE=UTC
VALIDATOR_POLL_INTERVAL_SECONDS=1
NOTIFIER_POLL_INTERVAL_SECONDS=5
